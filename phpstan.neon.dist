parameters:
    level: 8
    paths:
        - src
        - tests
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/wp-cli/wp-cli/php/utils.php
    scanDirectories:
        - vendor/lucatume/wp-browser/includes/core-phpunit/includes/factory
    excludePaths:
        analyse:
            - src/*/vendor/*
            - tests/CodeceptionSupport/*
