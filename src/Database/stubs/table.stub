<?php declare(strict_types=1);

namespace {{ namespace }};

use {{ foundation_database_managed_table }};
use {{ foundation_database_table }};
use {{ foundation_database_table_definition }};

final readonly class {{ class }} extends Table implements ManagedTable {

	private const string UNPREFIXED_TABLE_NAME = {{ table_php }};

	public function unprefixedName(): string {
		return self::UNPREFIXED_TABLE_NAME;
	}

	public function definition(): TableDefinition {
		$table = TableDefinition::for( $this );

		$table->bigIncrements( 'id' );
		$table->string( 'status', 20 )->default( 'draft' );
		$table->longText( 'payload' );
		$table->dateTime( 'created_at' );
		$table->dateTime( 'updated_at' )->nullable();
		$table->index( 'status', 'status' );

		return $table;
	}

}
