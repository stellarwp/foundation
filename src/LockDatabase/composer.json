{
    "name": "stellarwp/foundation-lock-database",
    "type": "library",
    "description": "Database-backed expiring locks using Foundation's shared WordPress connection.",
    "license": "GPL-2.0-or-later",
    "config": {
        "vendor-dir": "vendor",
        "preferred-install": "dist"
    },
    "require": {
        "php": ">=8.3",
        "stellarwp/foundation-container": "^2.0",
        "stellarwp/foundation-database": "^2.0",
        "stellarwp/foundation-lock": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "StellarWP\\Foundation\\LockDatabase\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    }
}
