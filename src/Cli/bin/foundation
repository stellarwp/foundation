#!/usr/bin/env php
<?php declare(strict_types=1);

use StellarWP\Foundation\Cli\Application;
use StellarWP\Foundation\Cli\CliProvider;
use StellarWP\Foundation\Cli\Tooling\ToolingProviderResolver;
use StellarWP\Foundation\Container\Configuration\ArrayConfiguration;
use StellarWP\Foundation\Container\ContainerFactory;

final class FoundationCliBootstrapException extends RuntimeException
{
}

try {
	$autoload = null;

	if (isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path'])) {
		$autoload = $GLOBALS['_composer_autoload_path'];
		unset($GLOBALS['_composer_autoload_path']);
	}

	foreach ([
		__DIR__ . '/../vendor/autoload.php',
		dirname(__DIR__, 3) . '/vendor/autoload.php',
		dirname(__DIR__, 3) . '/autoload.php',
		dirname(__DIR__, 5) . '/autoload.php',
	] as $file) {
		if (is_string($autoload) && is_readable($autoload)) {
			break;
		}

		if (is_readable($file)) {
			$autoload = $file;

			break;
		}
	}

	unset($file);

	if (! is_string($autoload) || ! is_readable($autoload)) {
		throw new FoundationCliBootstrapException(
			'Could not find Composer autoload.php. Run this command from a project with Composer dependencies installed, or run composer install first.'
		);
	}

	require $autoload;

	$configPath = (getcwd() ?: dirname(__DIR__, 3)) . '/config.php';
	$config = is_file($configPath) ? (static fn (string $path): mixed => require $path)($configPath) : [];

	if (! is_array($config)) {
		throw new FoundationCliBootstrapException('config.php must return a configuration array.');
	}

	$container = (new ContainerFactory())->create(new ArrayConfiguration($config));
	$container->register(CliProvider::class);
	foreach ($container->get(ToolingProviderResolver::class)->providers() as $provider) {
		if (strcasecmp(ltrim($provider, '\\'), CliProvider::class) !== 0) {
			$container->register($provider);
		}
	}

	exit($container->get(Application::class)->run());
} catch (FoundationCliBootstrapException $e) {
	fwrite(STDERR, 'Foundation CLI bootstrap failed: ' . $e->getMessage() . PHP_EOL);

	exit(1);
} catch (Throwable $e) {
	fwrite(STDERR, 'Foundation CLI failed to start: ' . $e->getMessage() . PHP_EOL);

	exit(1);
}
