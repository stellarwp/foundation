<?php declare(strict_types=1);

namespace Acme\Plugin\Database;

use Other\Migrations;
use Other\Tables;
use StellarWP\Foundation\Database\DatabaseProvider;

final class Provider
{
	public function register(): void {
		$this->container->singleton(Tables\Reports_Table::class);

		$this->container->mergeArrayVar(DatabaseProvider::MIGRATIONS, static fn ($c): array => [
			$c->get(Migrations\Create_Reports_Table::class),
		]);
	}
}
